{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Forward to the existing Cloudflare API without cross-origin browser requests.
	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy {$PLUOX_API_ORIGIN}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
