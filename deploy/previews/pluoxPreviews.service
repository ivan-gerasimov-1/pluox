[Unit]
Description=Dispatch trusted Pluox preview pipelines
After=docker.service caddy-gerasimov.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --exclusive /run/lock/pluox-preview-dispatch.lock /opt/pluox-preview-controller/previewCycle.sh
TimeoutStartSec=2min
