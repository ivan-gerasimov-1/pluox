{
  "name": "savee",
  "version": "0.1.0",
  "scripts": {
    "analyze-bundle": "cross-env NODE_ENV='production' BUNDLE_ANALYZER='on' npx webpack --mode production",
    "build": "npm run build@production",
    "build@development": "cross-env NODE_ENV='development' npx webpack --mode development",
    "build@production": "cross-env NODE_ENV='production' npx webpack --mode production",
    "serve": "npx serve --single --listen 3000 build/",
    "start": "cross-env NODE_ENV='development' npx webpack-dev-server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanJ0hnson/savee.git"
  },
  "author": "Ivan Gerasimov <ivangerasimow@gmail.com> (https://gerasimov.pw)",
  "license": "UNLICENSED",
  "private": true,
  "bugs": {
    "url": "https://github.com/EvanJ0hnson/savee/issues"
  },
  "homepage": "https://github.com/EvanJ0hnson/savee#readme",
  "dependencies": {
    "classnames": "2.2.6",
    "effector": "21.2.2",
    "effector-react": "21.0.4",
    "nanoid": "3.1.12",
    "react": "16.13.1",
    "react-dom": "16.13.1",
    "react-router-dom": "5.2.0"
  },
  "devDependencies": {
    "@svgr/webpack": "5.4.0",
    "@types/classnames": "2.2.10",
    "@types/react": "16.9.48",
    "@types/react-dom": "16.9.8",
    "@types/react-router-dom": "5.1.5",
    "clean-webpack-plugin": "3.0.0",
    "copy-webpack-plugin": "6.0.4",
    "cross-env": "7.0.2",
    "css-loader": "4.2.2",
    "html-webpack-plugin": "4.3.0",
    "mini-css-extract-plugin": "0.11.0",
    "postcss-loader": "3.0.0",
    "postcss-nested": "4.2.3",
    "postcss-preset-env": "6.7.0",
    "serve": "11.3.2",
    "source-map-loader": "1.1.0",
    "ts-loader": "8.0.3",
    "tsconfig-paths-webpack-plugin": "3.3.0",
    "typescript": "4.0.2",
    "webpack": "4.44.1",
