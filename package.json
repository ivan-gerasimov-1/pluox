{
	"name": "savee",
	"version": "0.1.0",
	"scripts": {
		"analyze": "npm run analyze@prod",
		"analyze@prod": "cross-env NODE_ENV='production' BUNDLE_ANALYZER='on' npx webpack --mode production",
		"build": "npm run build@production",
		"build@development": "cross-env NODE_ENV='development' npx webpack",
		"build@production": "cross-env NODE_ENV='production' npx webpack",
		"serve": "npx serve --single --no-request-logging --config ../serve.json --listen 3000 build/",
		"start": "cross-env NODE_ENV='development' npx webpack-dev-server"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EvanJ0hnson/savee.git"
	},
	"author": "Ivan Gerasimov <ivangerasimow@gmail.com> (https://gerasimov.pw)",
	"license": "UNLICENSED",
	"private": true,
	"bugs": {
		"url": "https://github.com/EvanJ0hnson/savee/issues"
	},
	"homepage": "https://github.com/EvanJ0hnson/savee#readme",
	"dependencies": {
		"clsx": "2.0.0",
		"ionicons": "7.1.2",
		"nanoid": "5.0.1",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-router": "6.16.0",
		"react-router-dom": "6.16.0",
		"react-swipeable-list": "1.9.1",
		"react-transition-group": "4.4.5",
		"zustand": "4.4.1"
	},
	"devDependencies": {
		"@pmmmwh/react-refresh-webpack-plugin": "0.5.11",
		"@svgr/webpack": "8.1.0",
		"@types/react": "18.2.23",
		"@types/react-dom": "18.2.8",
		"@types/react-router": "5.1.20",
		"@types/react-router-dom": "5.3.3",
		"@types/react-transition-group": "4.4.7",
		"clean-webpack-plugin": "4.0.0",
		"copy-webpack-plugin": "11.0.0",
		"cross-env": "7.0.3",
		"css-loader": "6.8.1",
		"css-minimizer-webpack-plugin": "5.0.1",
		"html-webpack-plugin": "5.5.3",
		"mini-css-extract-plugin": "2.7.6",
		"postcss-loader": "7.3.3",
		"postcss-nested": "6.0.1",
		"postcss-preset-env": "9.1.4",
		"prettier": "3.0.3",
		"react-refresh": "0.14.0",
		"react-refresh-typescript": "2.0.9",
		"serve": "14.2.1",
		"source-map-loader": "4.0.1",
		"ts-loader": "9.4.4",
		"tsconfig-paths-webpack-plugin": "4.1.0",
		"typescript": "5.2.2",
		"webpack": "5.88.2",
		"webpack-bundle-analyzer": "4.9.1",
		"webpack-cli": "5.1.4",
		"webpack-dev-server": "4.15.1"
	}
}
