{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Web App",
			"type": "node-terminal",
			"command": "npm --workspace=@savee/frontend start",
			"request": "launch",
			"cwd": "${workspaceFolder}/apps/frontend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "API",
			"command": "npm --workspace=@savee/backend-lite start",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend-lite",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		}
	],
	"compounds": [
		{
			"name": "App",
			"configurations": ["Web App", "API"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1,
				"echo": true,
				"reveal": "always"
			}
		}
	]
}
