{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		// UI
		{
			"name": "UI",
			"type": "node-terminal",
			"command": "npm --workspace=@pluox/frontend start",
			"request": "launch",
			"cwd": "${workspaceFolder}/apps/frontend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "Chrome (Debug Mode)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3000",
			"webRoot": "${workspaceFolder}/apps/frontend",
			"skipFiles": ["<node_internals>/**"],
			"port": 9222
		},

		// API
		{
			"name": "API (Cloudflare)",
			"command": "npm --workspace=@pluox/backend run start:cf",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},

		// Website
		{
			"command": "npm --workspace=@pluox/website run start",
			"name": "Website",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/website",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		}
	],
	"compounds": [
		{
			"name": "UI (Chrome)",
			"configurations": ["UI", "Chrome (Debug Mode)"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1,
				"echo": true,
				"reveal": "never"
			}
		},
		{
			"name": "UI (Chrome) with API",
			"configurations": ["UI", "Chrome (Debug Mode)", "API (Cloudflare)"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1,
				"echo": true,
				"reveal": "always"
			}
		},
		{
			"name": "UI with API",
			"configurations": ["UI", "API (Cloudflare)"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1,
				"echo": true,
				"reveal": "always"
			}
		}
	]
}
