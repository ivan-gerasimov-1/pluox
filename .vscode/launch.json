{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Backend",
			"command": "npm --workspace=@savee/backend start",
			"request": "launch",
			"type": "node-terminal"
		},
		{
			"name": "UI",
			"type": "node-terminal",
			"command": "npm start",
			"request": "launch"
		},
		{
			"type": "chrome",
			"request": "launch",
			"name": "Launch Chrome",
			"url": "http://localhost:3002",
			"webRoot": "${workspaceFolder}"
		}
	],
	"compounds": [
		{
			"name": "App",
			"configurations": ["UI", "Backend"],
			"stopAll": false,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1
			}
		}
	]
}
