{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		// Frontend
		{
			"name": "Web App",
			"type": "node-terminal",
			"command": "npm --workspace=@savee/frontend start",
			"request": "launch",
			"cwd": "${workspaceFolder}/apps/frontend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "Chrome (Debug)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3000",
			"webRoot": "${workspaceFolder}/apps/frontend",
			"skipFiles": ["<node_internals>/**"],
			"port": 9222
		},
		{
			"name": "Arc (Debug)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3000",
			"webRoot": "${workspaceFolder}/apps/frontend",
			"skipFiles": ["<node_internals>/**"],
			"runtimeExecutable": "/Applications/Arc.app/Contents/MacOS/Arc",
			"port": 9222
		},

		// Backend
		{
			"name": "API",
			"command": "npm --workspace=@savee/backend start",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "API (Next)",
			"command": "npm --workspace=@savee/backend run start:next",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "API (Cloudflare)",
			"command": "npm --workspace=@savee/backend run start:cf",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},

		// Website
		{
			"command": "npm --workspace=@savee/website run start",
			"name": "Website",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/website",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		}
	],
	"compounds": [
		{
			"name": "App",
			"configurations": ["Web App", "API"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1,
				"echo": true,
				"reveal": "always"
			}
		},
		{
			"name": "Web App (+ Chrome)",
			"configurations": ["Web App", "Chrome (Debug)"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1,
				"echo": true,
				"reveal": "never"
			}
		}
	]
}
