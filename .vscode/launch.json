{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Web App",
			"type": "node-terminal",
			"command": "npm --workspace=@savee/frontend start",
			"request": "launch",
			"cwd": "${workspaceFolder}/apps/frontend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			// TODO: Add launch config for Chrome in Debug Mode
			"name": "Web App (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3000",
			"webRoot": "${workspaceFolder}/apps/frontend",
			"port": 9222
		},
		{
			// TODO: Add launch config for Zen Browser in Debug Mode
			"name": "Web App (Zen Browser)",
			"type": "firefox",
			"request": "attach",
			"url": "http://localhost:3000",
			"webRoot": "${workspaceFolder}/apps/frontend",
			"firefoxExecutable": "/Applications/Zen Browser.app/Contents/MacOS/zen"
		},
		{
			"name": "API",
			"command": "npm --workspace=@savee/backend start",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "API (Next)",
			"command": "npm --workspace=@savee/backend run start:next",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "API (Cloudflare)",
			"command": "npm --workspace=@savee/backend run start:cf",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/backend",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"command": "npm --workspace=@savee/landing run start",
			"name": "Landing",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}/apps/landing",
			"sourceMaps": true,
			"skipFiles": ["<node_internals>/**"]
		}
	],
	"compounds": [
		{
			"name": "App",
			"configurations": ["Web App", "API"],
			"stopAll": true,
			"presentation": {
				"hidden": false,
				"group": "App",
				"order": 1,
				"echo": true,
				"reveal": "always"
			}
		}
	]
}
