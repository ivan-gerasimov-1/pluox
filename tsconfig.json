{
	"compilerOptions": {
		"target": "ES2021",
		"moduleResolution": "node",
		"module": "ES2022",
		"lib": ["ES2021", "DOM"],

		"baseUrl": "./",
		"outDir": "build/",

		"sourceMap": true,

		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,

		"jsx": "react-jsx",

		"paths": {
			"@domain/*": ["src/core/domain/*"],
			"@core/*": ["src/core/*"],

			"@components/*": ["src/components/*"],
			"@modules/*": ["src/modules/*"],
			"@screens/*": ["src/screens/*"],
			"@uiKit/*": ["src/uiKit/*"],
			"@utils/*": ["src/utils/*"],

			"@root/*": ["src/*"]
		}
	},
	"include": ["src/**/*", ".eslintrc.js"]
}
