{
	"compilerOptions": {
		"target": "ES2015",
		"moduleResolution": "node",
		"module": "ES2022",
		"lib": ["ES2021", "DOM"],

		"baseUrl": "./",
		"outDir": "build/",

		"sourceMap": true,

		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,

		"jsx": "react-jsx",

		"paths": {
			"@components/*": ["src/components/*"],
			"@modules/*": ["src/modules/*"],
			"@root/*": ["src/*"],
			"@screens/*": ["src/screens/*"],
			"@ui-kit/*": ["src/ui-kit/*"],
			"@utils/*": ["src/utils/*"]
		}
	},
	"include": ["src/**/*"]
}
