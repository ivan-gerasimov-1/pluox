{
	"name": "@pluox/web",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"__run__": "",
		"preview": "vite preview",
		"prestart": "npm run projects:build",
		"start": "vite --mode development",
		"__build__": "",
		"prebuild": "npm run projects:build",
		"build": "npm run build:production",
		"build:development": "vite build --mode development",
		"build:production": "vite build --mode production",
		"__analyze__": "",
		"analyze": "npm run analyze:production",
		"analyze:production": "DEV_BUNDLE_ANALYZER='on' vite build --mode production",
		"__lint__": "",
		"deprecated_lint": "eslint ./src",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:ci": "npm run lint:gihub",
		"lint:gihub": "oxlint --format=github",
		"__test__": "",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:start": "vitest",
		"test:start:ui": "vitest --ui --coverage",
		"__projects__": "",
		"projects:build": "npx tsc -b ../core ../kit"
	},
	"author": "Ivan Gerasimov <ivangerasimow@gmail.com> (https://gerasimov.dev)",
	"license": "UNLICENSED",
	"private": true,
	"dependencies": {
		"@fontsource-variable/inter": "5.2.8",
		"@radix-ui/react-slot": "1.2.4",
		"@sentry/react": "10.43.0",
		"@tanstack/react-query": "5.90.21",
		"@tanstack/react-query-devtools": "5.91.3",
		"clsx": "2.1.1",
		"cva": "npm:class-variance-authority@0.7.1",
		"dayjs": "1.11.20",
		"lucide-react": "0.577.0",
		"nanoid": "5.1.7",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "7.71.2",
		"react-router": "7.13.1",
		"react-scan": "0.5.3",
		"react-swipeable-list": "1.10.0",
		"react-transition-group": "4.4.5",
		"tailwindcss": "4.2.1"
	},
	"devDependencies": {
		"@lv48/oxlint-config": "",
		"@lv48/prettier-config": "",
		"@tailwindcss/vite": "4.2.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/react-router": "5.1.20",
		"@types/react-transition-group": "4.4.12",
		"@vitejs/plugin-react": "6.0.1",
		"@vitest/coverage-v8": "4.1.0",
		"@vitest/ui": "4.1.0",
		"typescript": "5.9.3",
		"vite": "8.0.0",
		"vite-bundle-analyzer": "1.3.6",
		"vite-plugin-checker": "0.12.0",
		"vite-plugin-html": "3.2.2",
		"vite-plugin-pwa": "1.2.0",
		"vitest": "4.1.0",
		"wrangler": "4.73.0"
	}
}
