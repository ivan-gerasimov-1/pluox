{
	"compilerOptions": {
		"target": "ES2021",
		"moduleResolution": "node",
		"module": "ES2022",
		"lib": ["ES2022", "DOM"],

		"baseUrl": "./",
		"outDir": "build/",

		"noEmit": true,
		"tsBuildInfoFile": "node_modules/.cache/.tsbuildinfo",

		"sourceMap": true,

		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,

		"jsx": "react-jsx",

		"paths": {
			"@root/*": ["src/*"],

			"@core/*": ["src/core/*"],
			"@domain/*": ["src/core/domain/*"],
			"@modules/*": ["src/modules/*"],
			"@utils/*": ["src/presentation/web-ui/utils/*"],

			"@components/*": ["src/presentation/web-ui/components/*"],
			"@screens/*": ["src/screens/*"],
			"@uiKit/*": ["src/presentation/web-ui/uiKit/*"],

			"@web/*": ["src/presentation/web-ui/*"]
		}
	},
	"include": ["src/**/*"]
}
