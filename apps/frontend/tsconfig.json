{
	"compilerOptions": {
		"target": "ES2021",
		"moduleResolution": "node",
		"module": "ES2022",
		"lib": ["ES2022", "DOM"],

		"baseUrl": "./",
		"outDir": "build/",

		"noEmit": true,
		"tsBuildInfoFile": "node_modules/.cache/.tsbuildinfo",

		"sourceMap": true,

		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,

		"jsx": "react-jsx",

		"paths": {
			"@/*": ["src/*"],
			"@core/*": ["../core/src/*"]
		}
	},
	"include": ["src/**/*"]
}
