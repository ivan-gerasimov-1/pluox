		"ionicons": "7.4.0",
		"nanoid": "5.0.7",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-router": "6.26.2",
		"react-router-dom": "6.26.2",
		"react-swipeable-list": "1.9.3",
		"react-transition-group": "4.4.5",
		"zustand": "4.5.5"
	},
	"devDependencies": {
		"@pmmmwh/react-refresh-webpack-plugin": "0.5.15",
		"@svgr/webpack": "8.1.0",
