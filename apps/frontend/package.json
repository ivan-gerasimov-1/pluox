{
	"name": "@pluox/frontend",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"__run__": "",
		"preview": "vite preview",
		"prestart": "npm run projects:build",
		"start": "vite --mode development",
		"__build__": "",
		"prebuild": "npm run projects:build",
		"build": "npm run build:production",
		"build:development": "vite build --mode development",
		"build:production": "vite build --mode production",
		"__analyze__": "",
		"analyze": "npm run analyze:production",
		"analyze:production": "DEV_BUNDLE_ANALYZER='on' vite build --mode production",
		"__lint__": "",
		"lint": "eslint ./src",
		"__test__": "",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:start": "vitest",
		"test:start:ui": "vitest --ui --coverage",
		"__projects__": "",
		"projects:build": "npx tsc -b ../core ../kit"
	},
	"author": "Ivan Gerasimov <ivangerasimow@gmail.com> (https://gerasimov.dev)",
	"license": "UNLICENSED",
	"private": true,
	"dependencies": {
