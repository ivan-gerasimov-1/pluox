{
	"name": "@pluox/backend",
	"version": "0.0.1",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"___start___": "",
		"start:next": "npm run start:dev:next",
		"start:dev:next": "node --env-file=.env --experimental-transform-types --watch ./src/index.node.ts",
		"start:prod:next": "node --env-file=.env --experimental-transform-types ./src/index.node.ts",
		"___start___cloudflare___": "",
		"start:cf": "npm run start:dev:cf",
		"start:dev:cf": "wrangler dev",
		"#NOT_IMPLEMENTED#start:prod:cf": "",
		"___test___": "",
		"test": "echo \"Error: no test specified\" && exit 1",
		"___build___": "",
		"prebuild": "npm run _build:removeDist && npm run _build:createDist",
		"build": "npm run _build:copyApp && npm run _build:copyAssets",
		"_build:removeDist": "rm -rf dist",
		"_build:createDist": "mkdir dist",
		"_build:copyApp": "cp -r src dist",
		"_build:copyAssets": "cp package.json .env dist",
		"__lint__": "",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"__format__": "",
		"format": "prettier --write ./src",
		"format:check": "prettier --check ./src"
	},
	"imports": {
		"#app/*": "./src/*.ts"
	},
	"author": "Ivan Gerasimov <ivangerasimow@gmail.com> (https://gerasimov.dev)",
	"license": "Apache-2.0",
	"description": "Pluox app backend (lite)",
	"dependencies": {
		"@hono/node-server": "1.19.11",
		"@hono/zod-validator": "0.7.6",
		"hono": "4.12.8",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "4.20260317.1",
		"@lv48/oxlint-config": "",
		"@lv48/prettier-config": "",
		"@types/node": "24.10.9",
		"wrangler": "4.75.0"
	}
}
