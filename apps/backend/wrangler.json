{
	"$schema": "../../node_modules/wrangler/config-schema.json",

	"name": "pluox-api",
	"main": "src/index.cloudflare.ts",
	"compatibility_date": "2025-11-11",
	"compatibility_flags": ["nodejs_compat"],
	"tsconfig": "./tsconfig.cloudflare.json",
	"minify": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "bd07d79d-f9d7-446c-b6a1-6369f13f2421",
			"database_name": "pluox",
			"migrations_dir": ".db/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CURRENCIES_KV",
			"id": "be6e18a5bb1c4a848bb4bc2e71238b4a"
		}
	],
	"vars": {
		"AUTH_COOKIE_NAME": "session",
		"APP_OPEN_EXCHANGE_RATES_API_URL": "https://openexchangerates.org/api"
	}
}
