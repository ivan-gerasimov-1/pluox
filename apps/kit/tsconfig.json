{
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,

		"target": "ES2021",
		"moduleResolution": "node",
		"module": "ES2022",
		"lib": ["ES2022", "DOM"],

		"baseUrl": "./",
		"outDir": "build/",

		"tsBuildInfoFile": "./node_modules/.cache/.tsbuildinfo",

		"sourceMap": true,

		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,

		"jsx": "react-jsx",

		"paths": {
			"@kit/*": ["./src/*"]
		}
	},
	"include": ["./src/**/*"]
}
